// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Definisi Role Pengguna
enum Role {
  PETANI
  HUB
  RESTAURANT
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String?   @unique
  password  String?   // Opsional untuk antisipasi OAuth, tapi wajib untuk login Credentials
  role      Role      @default(PETANI)
  username  String    @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relasi: Satu User (Petani) bisa memiliki banyak Product
  products  Product[]

  // Relasi: Produk yang diverifikasi dan dijual oleh Hub ini
  verifiedProducts Product[] @relation("HubVerifiedProducts")
}

model Product {
  id             String    @id @default(cuid())
  name           String
  description    String?   // Deskripsi dari Hub (opsional)
  stock          Int
  unit           String
  priceFarmer    Int
  priceHub       Int?      // Harga jual dari Hub (setelah diverifikasi)
  isVerified     Boolean   @default(false) // Status verifikasi oleh Hub
  imageUrl       String?   // URL gambar produk
  imageExpiresAt DateTime? // Gambar kedaluwarsa setelah 24 jam (seperti status WA/IG)
  
  // Relasi ke Petani yang menanam / memanen
  userId         String
  user           User      @relation(fields: [userId], references: [id])

  // Relasi ke Hub / Toko Pedagang yang memverifikasi dan menjual ke Restoran
  verifiedById   String?
  verifiedBy     User?     @relation("HubVerifiedProducts", fields: [verifiedById], references: [id])

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
